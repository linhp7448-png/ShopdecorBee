{
  "info": {
    "name": "Blackbox Testing - Product Service (5 POST)",
    "description": "Product Service blackbox testing - 5 POST test cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "03 - Product Service (5 POST)",
      "item": [
        {
          "name": "TC_PROD_01_Create_Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU_TEST_{{$randomInt}}\",\n  \"productName\": \"Test Product\",\n  \"price\": 100000,\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Test description\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 or 400 (API validation)', function () {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_PROD_02_Create_DuplicateSKU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU_TEST_123\",\n  \"productName\": \"Test Product\",\n  \"price\": 100000,\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Test description\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 (API returns 400 for duplicate)', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_PROD_03_Create_Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU_TEST_123\",\n  \"productName\": \"Test Product\",\n  \"price\": 100000,\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Test description\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_PROD_04_Create_InvalidPrice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU_TEST_123\",\n  \"productName\": \"Test Product\",\n  \"price\": -100,\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Test description\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_PROD_05_AddReview_Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great product!\"\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 400 (API validation)', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
