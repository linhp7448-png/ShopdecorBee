    {
      "name": "🔐 Setup - Đăng nhập lấy Token",
      "item": [
        {
          "name": "POST Login - User thường",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-SETUP-01: Login user thành công - Status 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TC-SETUP-01: Response có token', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('customerToken', data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
