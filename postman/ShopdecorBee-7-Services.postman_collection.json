{
  "info": {
    "_postman_id": "shopdecorbee-7-services",
    "name": "ShopdecorBee - 7 Services",
    "description": "API test collection cho 7 service chinh: Auth, Category, Product, Cart, Order, Payment, Wallet.\n\nThu tu chay: 00 Setup -> 01 Auth -> 02 Category -> 03 Product -> 04 Cart -> 05 Order -> 06 Payment / 07 Wallet.\n\nImport kem file ShopdecorBee.postman_environment.json va chon environment truoc khi chay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Seed All Demo Data",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/Maintenance/seed/all",
            "description": "Chay 1 lan neu DB trong. Tao admin, categories, products."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Co san pham', () => pm.expect(data.totalProducts).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Seed System Only (admin + settings)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/Maintenance/seed/system"
          }
        },
        {
          "name": "Seed Categories Only",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/Maintenance/seed/categories"
          }
        },
        {
          "name": "Seed Products Only",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/Maintenance/seed/products"
          }
        }
      ],
      "description": "Buoc 0: chay truoc khi test neu DB chua co du lieu."
    },
    {
      "name": "01 - Auth & User Service",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"fullName\": \"Nguyen Van Test\",\n  \"phone\": \"0901234567\",\n  \"password\": \"{{customerPassword}}\",\n  \"role\": \"customer\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('customerToken', pm.response.json().token);",
                  "}",
                  "pm.test('200 hoac 409 (email da ton tai)', () => {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
