    {
      "name": "05 - Order Service",
      "item": [
        {
          "name": "Create Order (for Payment COD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"0901234567\",\n  \"line1\": \"123 Le Loi\",\n  \"ward\": \"Phuong 1\",\n  \"district\": \"Quan 1\",\n  \"city\": \"TP.HCM\",\n  \"notes\": \"Don hang test Payment COD\"\n}"
            },
            "url": "{{baseUrl}}/api/orders",
            "description": "Chay Prepare Cart For Order truoc."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const id = pm.response.json().id;",
                  "    pm.environment.set('orderId', id);",
                  "    pm.environment.set('orderIdForPayment', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
