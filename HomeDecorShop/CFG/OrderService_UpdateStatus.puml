@startuml OrderService_UpdateStatus
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

title CFG - UpdateStatus
start
:RequireUser(token);
if (user.Role != Admin?) then (yes)
  :Throw ForbiddenException;
  stop
else (no)
  :Lấy Order từ orderRepository;
  if (order == null?) then (yes)
    :return null;
    stop
  else (no)
    :Gán order.Status = newStatus;
    if (newStatus == Completed?) then (yes)
      :Gán order.PaymentStatus = Paid;
    else (no)
    endif
    :orderRepository.Update(order);
    :return MapOrder(updated);
    stop
  endif
endif
@enduml
