@startuml OrderService_UpdateStatus
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
:user = RequireUser(token);
if (user.Role != Admin) then (yes)
  :throw ForbiddenException("Bạn không có quyền thực hiện hành động này");
  stop
else (no)
  :order = orderRepository.GetById(orderId);
  if (order is null) then (yes)
    :return null;
    stop
  else (no)
    :newStatus = MapFromSnakeCase<OrderStatus>(status);
    :order.Status = newStatus;
    :order.UpdatedAt = DateTime.UtcNow;
    
    if (newStatus == Completed) then (yes)
      :order.PaymentStatus = Paid;
    endif
    
    :return MapOrder(orderRepository.Update(order));
    stop
  endif
endif
@enduml
