@startuml CategoryService_Create
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #555555
}

start
:name = NormalizeName(input.Name);
:slug = NormalizeSlug(input.Slug);
:group = RequireActiveGroup(input.GroupId);

if (Slug đã tồn tại trong DB?) then (yes)
  :throw ConflictException("Category already exists");
  stop
else (no)
  :categoryToCreate = new Category {
    Name = name,
    Slug = slug,
    GroupId = group.Id,
    IsActive = input.IsActive
  };
  
  :created = repository.Create(categoryToCreate);
  
  :return MapCategory(created);
  stop
endif
@enduml
