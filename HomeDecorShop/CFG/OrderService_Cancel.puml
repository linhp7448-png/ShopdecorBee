@startuml OrderService_Cancel
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

title CFG - Cancel
start
:RequireUser(token);
:Lấy Order từ orderRepository;
if (order == null?) then (yes)
  :return null;
  stop
else if (order.UserId != user.UserId?) then (yes)
  :return null;
  stop
else (no)
  if (order.Status != PendingPayment?) then (yes)
    :Throw ConflictException;
    stop
  else (no)
    if (Có giao dịch VNPay pending?) then (yes)
      :Throw ConflictException;
      stop
    else (no)
      :Mở TransactionScope;
      while (Lặp qua từng orderItem?) is (còn phần tử)
        if (Product tồn tại?) then (yes)
          :RestoreStock(product, Quantity);
          :Cập nhật product;
        else (no)
        endif
      endwhile (hết phần tử)
      
      :Cập nhật Status = Cancelled;
      :Cập nhật PaymentStatus = Cancelled;
      :orderRepository.Update(order);
      :Complete TransactionScope;
      :return MapOrder(updated);
      stop
    endif
  endif
endif
@enduml
