@startuml CategoryService_Delete
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
if (repository.GetById(categoryId) is null?) then (yes)
  :return CategoryDeleteResult.NotFound;
  stop
else (no)
  if (repository.HasProducts(categoryId)) then (yes)
    :return CategoryDeleteResult.HasProducts;
    stop
  else (no)
    if (repository.Delete(categoryId)) then (yes)
      :return CategoryDeleteResult.Deleted;
      stop
    else (no)
      :return CategoryDeleteResult.NotFound;
      stop
    endif
  endif
endif
@enduml
