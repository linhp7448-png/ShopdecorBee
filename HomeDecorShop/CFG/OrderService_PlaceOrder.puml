@startuml OrderService_PlaceOrder
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

title CFG - PlaceOrder
start
:RequireUser(token);
:Lấy Cart từ cartRepository;
if (cart == null OR cart.Items.Count == 0?) then (yes)
  :Throw EmptyCartException;
  stop
else (no)
  :ResolveShippingAddress(user, input);
  :Tạo mảng cartItems;
  while (Lặp qua từng cartItem trong cartItems?) is (còn phần tử)
    :Lấy product = productRepository.GetById(ProductId);
    if (product == null?) then (yes)
      :Throw NotFoundException;
      stop
    else (no)
      if (!product.IsActive OR category Inactive?) then (yes)
        :Throw ConflictException;
        stop
      else (no)
        if (StockLeft < Quantity?) then (yes)
          :Throw ConflictException;
          stop
        else (no)
        endif
      endif
    endif
  endwhile (hết phần tử)
  
  :Map orderItems;
  :Tính toán subtotal, tạo Order object;
  :Mở TransactionScope;
  while (Lặp qua từng orderItem?) is (còn phần tử)
    :DecreaseStock(product, Quantity);
    :Cập nhật product;
  endwhile (hết phần tử)
  
  :Tạo Order trong repository;
  :Clear items trong cart và cập nhật cart;
  :Complete TransactionScope;
  :return MapOrder(created);
  stop
endif
@enduml
