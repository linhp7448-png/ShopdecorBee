@startuml CartService_RemoveItem
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
:user = RequireUser(token);
:cart = cartRepository.GetByUserId(user.UserId);
if (cart is null?) then (yes)
  :return false;
  stop
else (no)
  :item = cart.Items.FirstOrDefault(current => current.Id == itemId);
  if (item is null?) then (yes)
    :return false;
    stop
  else (no)
    :cart.Items.Remove(item);
    :cart.UpdatedAt = DateTime.UtcNow;
    :cartRepository.Update(cart);
    :return true;
    stop
  endif
endif
@enduml
