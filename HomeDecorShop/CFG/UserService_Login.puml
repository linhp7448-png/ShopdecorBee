@startuml UserService_Login
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
:user = _repository.GetByEmail(Normalize(input.Email));
if (user is null hoặc sai mật khẩu verified bởi BCrypt?) then (yes)
  :return null;
  stop
else (no)
  if (!user.IsEmailConfirmed) then (yes)
    :throw RequestValidationException("Please confirm your email");
    stop
  else (no)
    if (!user.IsActive) then (yes)
      :throw RequestValidationException("Account is locked");
      stop
    else (no)
      :user.CurrentToken = Guid.NewGuid().ToString("N");
      :_repository.Update(user);
      :return new AuthResult(user.CurrentToken, MapUser(user));
      stop
    endif
  endif
endif
@enduml