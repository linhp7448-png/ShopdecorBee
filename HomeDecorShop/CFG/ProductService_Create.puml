@startuml ProductService_Create
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
:category = RequireActiveCategory(input.CategoryId);
:normalizedSku = NormalizeSku(input.Sku);
:normalizedSlug = NormalizeSlug(input.Slug);

if (Giá bán không hợp lệ HOẶC Sku/Slug đã tồn tại?) then (yes)
  :throw BadRequestException("Dữ liệu sản phẩm không hợp lệ");
  stop
else (no)
  :now = DateTime.UtcNow;
  :Khởi tạo thực thể Product mới từ dữ liệu input\n- Gán Sku, Slug, Name, Price\n- Chuẩn hóa StockLeft, Rating, Reviews\n- Thiết lập trạng thái InStock và IsActive;
  :created = repository.Create(product);
  :return MapProduct(repository.GetById(created.ProductId) ?? created);
  stop
endif
@enduml