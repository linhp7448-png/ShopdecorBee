@startuml PaymentService_GetById
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}

start
:user = RequireUser(token);
:payment = paymentRepository.GetById(paymentId);

if (payment is null || payment.Order.UserId != user.UserId) then (yes)
  :return null;
  stop
else (no)
  :return MapPayment(payment);
  stop
endif
@enduml
