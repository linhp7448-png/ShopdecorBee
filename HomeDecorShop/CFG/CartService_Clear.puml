@startuml CartService_Clear
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

start
:user = RequireUser(token);
:cart = cartRepository.GetByUserId(user.UserId);
if (cart is null?) then (yes)
  :return true;
  stop
else (no)
  :cart.Items.Clear();
  :cart.UpdatedAt = DateTime.UtcNow;
  :cartRepository.Update(cart);
  :return true;
  stop
endif
@enduml
